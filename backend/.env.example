# Copy this to .env and fill in real values. .env is gitignored -- never commit it.

# Railway Postgres connection string, auto-injected as DATABASE_URL once the
# Postgres add-on is provisioned in the Railway project. Format:
# postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=

# Backend-only. Never sent to the frontend, never committed.
OPENAI_API_KEY=

# The deployed frontend origin, for CORS. Vercel URL in production.
FRONTEND_ORIGIN=http://localhost:3000

# "development" (default) relaxes cookie Secure/SameSite for localhost.
# "production" enables SameSite=None; Secure for the Vercel <-> Railway split.
ENVIRONMENT=development

# Gates POST /api/admin/reset-db (wipes every session's data -- see
# app/routers/admin.py). Leave unset to disable the endpoint entirely. Set to
# a random string before deploying if you want the reset control in the
# Guide panel's Reference tab to actually work; keep it out of version
# control same as everything else in this file.
ADMIN_RESET_TOKEN=
